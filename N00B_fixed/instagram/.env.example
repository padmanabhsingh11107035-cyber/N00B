# NOOB backend configuration
#
# This app works with none of these set (in-memory data, no AI, uploads as
# inline base64) — every one of them is an optional upgrade, not a
# requirement to run. Set these on the actual Railway service (Railway
# dashboard → your service → Variables), not in this file — this file is
# just a reference copy, never commit real values into it.
#
# Restart the Railway service after changing any of these — the app reads
# them once at boot and logs a checklist on every startup (Railway → your
# service → Deployments → View Logs) showing which of these are missing.

# --- Database (MongoDB Atlas) ---
# Without this, all data (accounts, posts, messages, everything) lives only
# in server memory and is wiped on every restart/redeploy. Get a free
# connection string from https://cloud.mongodb.com — create a cluster, add
# a database user, allow network access from anywhere (0.0.0.0/0) unless
# using Atlas's Railway integration, then copy the "Connect your application"
# URI.
MONGODB_URI=

# --- Media Storage (Backblaze B2) ---
# Without these, uploaded photos/videos/audio are embedded directly as
# base64 text in every API response instead of real object storage — works
# for light use, won't scale. Get these from https://www.backblaze.com/b2 →
# create a bucket (Private) → App Keys → create a new application key.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
# Optional — only needed if your B2 bucket isn't in the default region:
B2_ENDPOINT=

# --- AI Customer Support (Groq) ---
# Without this, the AI chat/voice call falls back to canned replies instead
# of a real model. Free key from https://console.groq.com/keys.
GROQ_API_KEY=

# ============================================================
# The following are NOT Railway variables — they're GitHub Actions
# secrets for the Android build, set at:
# github.com/<you>/<repo>/settings/secrets/actions
# ============================================================
#
# ANDROID_KEYSTORE_BASE64   — a release signing keystore, base64-encoded.
#                             Without this, the CI build still produces a
#                             debug APK (fine for sideloading/testing) but
#                             skips the signed release AAB Play Store needs.
# ANDROID_KEYSTORE_PASSWORD — password for that keystore
# ANDROID_KEY_ALIAS         — the key alias inside the keystore
# ANDROID_KEY_PASSWORD      — password for that specific key
# GOOGLE_SERVICES_JSON      — Firebase config, only needed for push
#                             notifications to actually deliver
