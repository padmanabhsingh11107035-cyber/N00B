<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same launch theme as values/styles.xml, and the launch screen is drawn from the very top (behind the camera cut-out / notch and the clock) to the very bottom (behind the navigation bar):
         transparent bars over the yellow window, dark icons on yellow. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/noob_yellow</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash_yellow</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
