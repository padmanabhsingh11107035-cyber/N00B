# Security headers for every page and file of the NOOB website (Cloudflare reads this file).
# Two more locks than before: Cross-Origin-Opener-Policy (a page that NOOB opens in a new window cannot be used to reach back into NOOB, and another site that opens NOOB cannot keep a
# handle on it) and upgrade-insecure-requests (a picture or file asked for over plain http is fetched over https instead of being shown through an unprotected connection).
# These narrow what a page is even ALLOWED to do — real hardening against a hijacked or injected
# script (XSS), not a screenshot deterrent. See src/utils/contentProtection.ts for that, and its own
# honest limits: no website can block an operating system's screenshot tool.
# The app may show other websites inside it (frame-src https:): NOOB AI (https://ai.nooob.xyz, which may also use the microphone) and the in-app
# browser for links people open (src/components/Common/InAppBrowser.tsx, sandboxed, no camera / microphone / location). The app itself still
# cannot be shown inside any other site (frame-ancestors).
# Live Streaming / Live Lounge video runs through Agora, whose domains (agora.io, sd-rtn.com) must stay in
# connect-src or the browser silently blocks every connection to it — this is why both looked "broken" (stuck
# on Connecting, NETWORK_ERROR in the console) everywhere despite the app's own code and Agora account being fine.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self "https://ai.nooob.xyz"), autoplay=(self "https://ai.nooob.xyz"), geolocation=(self), display-capture=(self), payment=(), usb=(), serial=(), bluetooth=(), midi=(), interest-cohort=(), browsing-topics=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Permitted-Cross-Domain-Policies: none
  Content-Security-Policy: default-src 'self'; script-src 'self' blob: https://static.cloudflareinsights.com https://www.youtube.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://abffssydapumuhwgzeck.supabase.co wss://abffssydapumuhwgzeck.supabase.co https://cloudflareinsights.com https://ai.nooob.xyz https://api.github.com https://*.agora.io wss://*.agora.io https://*.sd-rtn.com wss://*.sd-rtn.com https://*.metered.live stun: turn: turns:; frame-src https:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests

# The page the two buttons of the "Is this you?" login email open: its address carries a one-time secret after the #, so it is never cached and never sent on as a referrer.
/login-approval
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  Cache-Control: no-store
# Helix Fall (the 3D tower game on the Games page) runs inside the app in a frame of its own, from this same site. It is the one place the app is allowed to be framed (by itself only),
# and its own scripts and ball model are the only things it loads. Everything else stays as strict as the rest of the site: no other site, no network, no frames.
/games/helix-fall/*
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' blob: data:; connect-src 'self' blob: data:; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'none'
# Neon Alley (a game made with the Godot engine) runs in a frame of its own, from this site as well. The engine needs WebAssembly and the game's scripts need to evaluate small bits of
# code; both are allowed for this folder only. Its two big files come from /games/neon-alley/data/ (see worker/index.js).
/games/neon-alley/*
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' blob: data:; connect-src 'self' blob: data:; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'none'
# Underhall: After Curfew (a 3D game made with Three.js) runs in a frame of its own, from this same site. Only its own scripts, models, pictures, sounds and fonts are allowed; it needs no
# network, no frames and no WebAssembly.
/games/underhall/*
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' blob: data:; connect-src 'self' blob: data:; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'none'
/games/underhall/index.html
  Cache-Control: no-cache
/games/underhall/assets/*
  Cache-Control: public, max-age=31536000, immutable
/games/underhall/models/*
  Cache-Control: public, max-age=86400
/games/underhall/tex/*
  Cache-Control: public, max-age=86400
/games/underhall/audio/*
  Cache-Control: public, max-age=86400
/games/underhall/fx/*
  Cache-Control: public, max-age=86400
/games/underhall/title/*
  Cache-Control: public, max-age=86400
/games/underhall/fonts/*
  Cache-Control: public, max-age=604800
/games/neon-alley/index.html
  Cache-Control: no-cache
/games/helix-fall/index.html
  Cache-Control: no-cache
/games/helix-fall/assets/*
  Cache-Control: public, max-age=31536000, immutable
/games/helix-fall/fonts/*
  Cache-Control: public, max-age=604800
/game-posters/*
  Cache-Control: public, max-age=604800

# The files that decide whether the app is up to date are never kept by a browser or a CDN: the page itself, the tiny file naming the current build (the app re-reads
# it to know a newer version exists, see src/utils/appVersion.ts) and the service worker. Everything else has a fingerprint in its name and can be kept forever.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/version.json
  Cache-Control: no-store
/sw.js
  Cache-Control: no-cache

# Every file in /assets has a fingerprint in its name (a changed file gets a new name), so it can be kept for a year without ever asking the server again. Without this the phone
# asked the server about every one of the 30-odd files on every visit, which is a lot of waiting on a slow connection. The pictures of the app (brand, live pictures, stickers,
# food) change rarely and are kept for a week.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/brand/*
  Cache-Control: public, max-age=604800
/live-avatars/*
  Cache-Control: public, max-age=604800
/draw-stickers/*
  Cache-Control: public, max-age=604800
/food-hero/*
  Cache-Control: public, max-age=604800
