{
  // Cloudflare hosting for the NOOB website: serves the built files in ./dist
  // (made by "npx vite build"). Any address that is not a real file falls back to the app,
  // so links like /profile or /reels open correctly when a page is refreshed.
  "name": "n00b",
  "compatibility_date": "2026-09-01",
  // A small script answers only the two big files of Neon Alley (too large for a website file, kept in the repository's "game-data" release) and every picture, video and song
  // of the app (/m/<key>, kept in the data centre's cache so Supabase Storage is not asked for the same file again and again); every other address is served straight from the
  // files, as before. See worker/index.js.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/games/neon-alley/data/*", "/m/*"]
  }
}
